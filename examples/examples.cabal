name:                 examples
version:              0.8.0
synopsis:             Examples of using gi-gtk4-declarative and gi-gtk4-declarative-app-simple.
description:          Examples showcasing the use of gi-gtk4-declarative and
                      gi-gtk4-declarative-app-simple in a multitude of ways. These try to cover
                      commonly used widgets and the special features of gi-gtk4-declarative atop
                      the regular GTK+ bindings (gi-gtk).
license:              MPL-2.0
license-file:         LICENSE
author:               Oskar Wickström
maintainer:           oskar.wickstrom@gmail.com
copyright:            Oskar Wickström
category:             Graphics
build-type:           Simple
cabal-version:        >=1.10
tested-with:          GHC == 9.10.3

executable example
  main-is:              Main.hs
  other-modules:        AddBoxes
                      , Columns
                      , Controllers
                      , CSS
                      , CustomWidget
                      , Dialog
                      , Exit
                      , FileChooser
                      , Functor
                      , Grid
                      , Hello
                      , ListBox
                      , ManyBoxes
                      , MenuBar
                      , Stack
                      , Notebook
                      , Paned
  build-depends:        base                          >=4.10 && <5
                      , async                         >=2.2  && <2.3
                      , bytestring                    >=0.10 && <0.13
                      , gi-gobject                    >=2    && <3
                      , gi-glib                       >=2    && <3
                      , gi-gtk                        >=4    && <5
                      , gi-gio                        >=2    && <3
                      , gi-gtk4-declarative            >=0.8  && <0.9
                      , gi-gtk4-declarative-app-simple >=0.8  && <0.9
                      , gi-gdk                        >=4    && <5
                      , haskell-gi                    >=0.26 && <0.27
                      , haskell-gi-base               >=0.26 && <0.27
                      , pipes                         >=4    && <5
                      , pipes-concurrency             >=2    && <3
                      , stm                           >=2.5  && <2.6
                      , pipes-extras                  >=1    && <2
                      , text                          >=1.2  && <2.2
                      , vector                        >=0.12 && <0.14
  default-language:     Haskell2010
  ghc-options:          -O2 -Wall -threaded
