name:                 gi-gtk4-declarative
version:              0.8.0
synopsis:             Declarative GTK 4 programming in Haskell
description:          A declarative programming model for GTK 4 user
                      interfaces, implementing support for various widgets
                      and generalized patching. This library aims to extend the
                      gi-gtk library as transparently as possible, and to be
                      a reusable library for multiple application architectures
                      and styles.

                      This is a fork of
                      [gi-gtk-declarative](https://hackage.haskell.org/package/gi-gtk-declarative),
                      which targets GTK 3. The module names are the same.

                      See [the project website](https://owickstrom.github.io/gi-gtk-declarative/)
                      for user guides and more information.
license:              MPL-2.0
license-file:         LICENSE
author:               Oskar Wickström
maintainer:           oskar.wickstrom@gmail.com
copyright:            Oskar Wickström
homepage:             https://owickstrom.github.io/gi-gtk-declarative/
bug-reports:          https://github.com/owickstrom/gi-gtk-declarative/issues
category:             Graphics
build-type:           Simple
cabal-version:        >=1.10
extra-source-files:   CHANGELOG.md
                    , test/InputApp.hs
tested-with:          GHC == 9.10.3

source-repository head
  type:     git
  location: https://github.com/owickstrom/gi-gtk-declarative


library
  exposed-modules:      GI.Gtk.Declarative
                      , GI.Gtk.Declarative.Attributes
                      , GI.Gtk.Declarative.Attributes.Collected
                      , GI.Gtk.Declarative.Attributes.Internal
                      , GI.Gtk.Declarative.Attributes.Internal.EventHandler
                      , GI.Gtk.Declarative.Attributes.Internal.Conversions
                      , GI.Gtk.Declarative.Bin
                      , GI.Gtk.Declarative.CustomWidget
                      , GI.Gtk.Declarative.Container
                      , GI.Gtk.Declarative.Container.Box
                      , GI.Gtk.Declarative.Container.Class
                      , GI.Gtk.Declarative.Container.ActionBar
                      , GI.Gtk.Declarative.Container.CenterBox
                      , GI.Gtk.Declarative.Container.Fixed
                      , GI.Gtk.Declarative.Container.FlowBox
                      , GI.Gtk.Declarative.Container.Grid
                      , GI.Gtk.Declarative.Container.HeaderBar
                      , GI.Gtk.Declarative.Container.ListBox
                      , GI.Gtk.Declarative.Container.Notebook
                      , GI.Gtk.Declarative.Container.Overlay
                      , GI.Gtk.Declarative.Container.Paned
                      , GI.Gtk.Declarative.Container.Patch
                      , GI.Gtk.Declarative.Container.Stack
                      , GI.Gtk.Declarative.EventController
                      , GI.Gtk.Declarative.EventSource
                      , GI.Gtk.Declarative.MenuModel
                      , GI.Gtk.Declarative.ModelView.ColumnView
                      , GI.Gtk.Declarative.ModelView.Internal
                      , GI.Gtk.Declarative.ModelView.ListView
                      , GI.Gtk.Declarative.Patch
                      , GI.Gtk.Declarative.References
                      , GI.Gtk.Declarative.SingleWidget
                      , GI.Gtk.Declarative.Slots
                      , GI.Gtk.Declarative.State
                      , GI.Gtk.Declarative.Widget
                      , GI.Gtk.Declarative.Widget.Conversions
  build-depends:        base                   >=4.10 && <5
                      , containers             >=0.6  && <0.9
                      , data-default-class     >=0.1  && <0.3
                      , gi-gobject             >=2    && <3
                      , gi-glib                >=2    && <3
                      , gi-gio                 >=2    && <3
                      , gi-gdk                 >=4    && <5
                      , gi-gtk                 >=4    && <5
                      , haskell-gi             >=0.26 && <0.27
                      , haskell-gi-base        >=0.26 && <0.27
                      , haskell-gi-overloading >=1.0  && <1.1
                      , mtl                    >=2.2  && <2.4
                      , text                   >=1.2  && <2.2
                      , unordered-containers   >=0.2  && <0.3
                      , vector                 >=0.12 && <0.14

  hs-source-dirs:       src
  default-language:     Haskell2010
  ghc-options:          -Wall

test-suite gi-gtk4-declarative-tests
  type:              exitcode-stdio-1.0
  hs-source-dirs:    test
  main-is:           Main.hs
  build-depends:     base                 >= 4        && < 5
                   , async
                   , containers
                   , gi-glib
                   , gi-gio
                   , gi-gdk
                   , gi-gsk
                   , gi-gobject
                   , gi-gtk >=4 && <5
                   , gi-gtk4-declarative
                   , haskell-gi-base
                   , hedgehog >= 1 && < 2
                   , mtl
                   , safe-exceptions
                   , stm
                   , text
                   , vector
                   , unordered-containers
  ghc-options:       -Wall -O2 -rtsopts -with-rtsopts=-N -threaded
  default-language:  Haskell2010
  other-modules:     GI.Gtk.Declarative.AfterCreatedTest
                   , GI.Gtk.Declarative.ContainerTest
                   , GI.Gtk.Declarative.CustomWidgetTest
                   , GI.Gtk.Declarative.EventControllerTest
                   , GI.Gtk.Declarative.MenuModelTest
                   , GI.Gtk.Declarative.ModelViewTest
                   , GI.Gtk.Declarative.PatchTest
                   , GI.Gtk.Declarative.ReferenceTest
                   , GI.Gtk.Declarative.SlotTest
                   , GI.Gtk.Declarative.TestUtils
                   , GI.Gtk.Declarative.TestWidget

benchmark gi-gtk4-declarative-bench
  type:              exitcode-stdio-1.0
  hs-source-dirs:    bench
  main-is:           Benchmark.hs
  build-depends:     base       >= 4        && < 5
                   , criterion  >= 1.5      && < 1.7
                   , gi-glib    >= 2        && < 3
                   , gi-gtk     >= 4        && < 5
                   , gi-gtk4-declarative
                   , text       >= 1.2      && < 2.2
                   , vector     >= 0.12     && < 0.14
  ghc-options:       -Wall -threaded
  default-language:  Haskell2010
